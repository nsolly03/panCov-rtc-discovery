ollupGa","is_regex":false,"category":"unknown","required":false},{"name":"_rollupGa_ga_4ZR516VVRP","is_regex":false,"category":"unknown","required":false},{"name":"amp_1823b4","is_regex":false,"category":"unknown","required":false},{"name":"amp_213194","is_regex":false,"category":"unknown","required":false}],
    options: {"cookie_expiration":395,"use_rfc_cookie":true,"revision":5,"current_lang":"default","autoclear_cookies":true,"hide_from_bots":true,"gui_options":{"consent_modal":{"layout":"cloud","position":"bottom right","transition":"slide","swap_buttons":true},"settings_modal":{"layout":"bar","position":"right","transition":"slide"}},"languages":{"default":{"consent_modal":{"title":"We use cookies","description":"This website uses essential cookies to ensure its proper operation and tracking cookies to understand how you interact with it. The latter will be set only upon approval. <br\/><br\/>Read more about our <a aria-label='Privacy policy' class='cc-link' href='\/privacy-policy'>Privacy policy<\/a>{{revision_message}}","revision_message":"<br\/><br\/>Sorry to bother you again, but our terms have changed.","primary_btn":{"text":"Accept all","role":"accept_all"},"secondary_btn":{"text":"Settings","role":"settings"}},"settings_modal":{"title":"Cookie preferences","save_settings_btn":"Save settings","accept_all_btn":"Accept all","close_btn_label":"Close","reject_all_btn":"Reject all","cookie_table_headers":[{"name":"Name"},{"description":"Description"},{"provider":"Provider"},{"expiration":"Expiration"}],"blocks":[{"title":"Cookie usage","description":"We use cookies to ensure the basic functionalities of the website and to enhance your online experience. You can choose for each category to opt-in\/out whenever you want."},{"title":"Strictly necessary cookies","description":"These cookies are essential for the proper functioning of this website. Without these cookies, this website would not work properly.","toggle":{"value":"functional","enabled":true,"readonly":true},"cookie_table":[{"name":"__cflb","description":"&nbsp;","is_regex":false,"provider":"api2.hcaptcha.com","expiration":"1 day"},{"name":"CookieConsent","description":"Stores the user's cookie consent state for the current domain","is_regex":false,"provider":"enamine.net","expiration":"1 year"},{"name":"hex (32)","description":"Used to manage server calls to the website's backend systems.  ","is_regex":false,"provider":"enamine.net","expiration":"session"},{"name":"incap_ses_#","description":"Preserves users states across page requests.","is_regex":false,"provider":"enamine.net","expiration":"session"},{"name":"nlbi_#","description":"Used to ensure website security and fraud detection.","is_regex":false,"provider":"enamine.net","expiration":"session"},{"name":"visid_incap_#","description":"Preserves users states across page requests.","is_regex":false,"provider":"enamine.net","expiration":"1 year"},{"name":"bcookie","description":"Used in order to detect spam and improve the website's security. ","is_regex":false,"provider":"linkedin.com","expiration":"1 year"},{"name":"li_gc","description":"Stores the user's cookie consent state for the current domain","is_regex":false,"provider":"linkedin.com","expiration":"180 days"},{"name":"bscookie","description":"This cookie is used to identify the visitor through an application. This allows the visitor to login to a website through their LinkedIn application for example.","is_regex":false,"provider":"www.linkedin.com","expiration":"1 year"},{"name":"^_hjSessionUser_","description":"Hotjar cookie that is set when a user first lands on a page with the Hotjar script. It is used to persist the Hotjar User ID, unique to that site on the browser. This ensures that behavior in subsequent visits to the same site will be attributed to the same user ID.","is_regex":true,"provider":"Hotjar","expiration":"365 days"},{"name":"n3t_cc","description":"This cookie holds user cookies consent info.","is_regex":false,"provider":"Enamine","expiration":"395 days"},{"name":"^incap_ses_","description":"This cookie is set to allow a visitor to receive site content from one out of multiple servers as the visitor browses the site. This allows the visitor's session to be maintained.","is_regex":true,"provider":"Imperva","expiration":"session"},{"name":"^_hjSession_","description":"A cookie that holds the current session data. This ensues that subsequent requests within the session window will be attributed to the same Hotjar session.","is_regex":true,"provider":"Hotjar","expiration":"30 minutes"}]},{"title":"Preferences cookies","description":"These cookies helps us to improve your online experience, and it stores some of your preferences.","toggle":{"value":"preferences","enabled":false,"readonly":false},"cookie_table":[{"name":"lidc","description":"Registers which server-cluster is serving the visitor. This is used in context with load balancing, in order to optimize user experience.  ","is_regex":false,"provider":"linkedin.com","expiration":"1 day"}]},{"title":"Analytical cookies","description":"These cookies collect information about how you use the website, which pages you visited and which links you clicked on. All of the data is anonymized and cannot be used to identify you.","toggle":{"value":"analytics","enabled":false,"readonly":false},"cookie_table":[{"name":"_hjSession_#","description":"Collects statistics on the visitor's visits to the website, such as the number of visits, average time spent on the website and what pages have been read.","is_regex":false,"provider":"enamine.net","expiration":"1 day"},{"name":"_hjSessionUser_#","description":"Collects statistics on the visitor's visits to the website, such as the number of visits, average time spent on the website and what pages have been read.","is_regex":false,"provider":"enamine.net","expiration":"1 year"},{"name":"_tldtest_#","description":"Registers statistical data on users' behaviour on the website. Used for internal analytics by the website operator. ","is_regex":false,"provider":"enamine.net","expiration":"session"},{"name":"amp_#","description":"Registers statistical data on users' behaviour on the website. Used for internal analytics by the website operator. ","is_regex":false,"provider":"enamine.net","expiration":"1 year"},{"name":"amp_cookie_test#","description":"Registers statistical data on users' behaviour on the website. Used for internal analytics by the website operator. ","is_regex":false,"provider":"enamine.net","expiration":"session"},{"name":"amplitude_#","description":"Registers statistical data on users' behaviour on the website. Used for internal analytics by the website operator. ","is_regex":false,"provider":"enamine.net","expiration":"1 year"},{"name":"hjActiveViewportIds","description":"This cookie contains an ID string on the current session. This contains non-personal information on what subpages the visitor enters \u2013 this information is used to optimize the visitor's experience.","is_regex":false,"provider":"hotjar.com","expiration":"Persistent"},{"name":"hjViewportId","description":"Saves the user's screen size in order to adjust the size of images on the website.","is_regex":false,"provider":"hotjar.com","expiration":"session"},{"name":"^_ga_","description":"ID used to identify users","is_regex":true,"provider":"Google Analytics","expiration":"2 years"}]},{"title":"Marketing cookies","description":"These cookies are used to make advertising messages more relevant to you. They prevent the same ad from continuously reappearing, ensure that ads are properly displayed for advertisers, and in some cases select advertisements that are based on your interests.","toggle":{"value":"marketing","enabled":false,"readonly":false},"cookie_table":[{"name":"___utmvc","description":"Collects information on user behaviour on multiple websites. This information is used in order to optimize the relevance of advertisement on the website.","is_regex":false,"provider":"enamine.net","expiration":"1 day"},{"name":"_ga","description":"Used to send data to Google Analytics about the visitor's device and behavior. Tracks the visitor across devices and marketing channels.","is_regex":false,"provider":"enamine.net","expiration":"PLG_SYSTEM_N3TCOOKIECONSENT_SCAN_COOKIE_EXPIRATION_YEARS"},{"name":"_ga_#","description":"Used to send data to Google Analytics about the visitor's device and behavior. Tracks the visitor across devices and marketing channels.","is_regex":false,"provider":"enamine.net","expiration":"PLG_SYSTEM_N3TCOOKIECONSENT_SCAN_COOKIE_EXPIRATION_YEARS"},{"name":"_gat","description":"Used to send data to Google Analytics about the visitor's device and behavior. Tracks the visitor across devices and marketing channels.","is_regex":false,"provider":"enamine.net","expiration":"1 day"},{"name":"_gid","description":"Used to send data to Google Analytics about the visitor's device and behavior. Tracks the visitor across devices and marketing channels.","is_regex":false,"provider":"enamine.net","expiration":"1 day"},{"name":"NID","description":"&nbsp;","is_regex":false,"provider":"google.com","expiration":"6 months"},{"name":"collect","description":"Used to send data to Google Analytics about the visitor's device and behavior. Tracks the visitor across devices and marketing channels.","is_regex":false,"provider":"google-analytics.com","expiration":"session"},{"name":"_ir","description":"Collects information on user behaviour on multiple websites. This information is used in order to optimize the relevance of advertisement on the website.","is_regex":false,"provider":"pinterest.com","expiration":"session"},{"name":"#-#","description":"Used to track user\u2019s interaction with embedded content.","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"iU5q-!O9@$","description":"Registers a unique ID to keep statistics of what videos from YouTube the user has seen.","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"LAST_RESULT_ENTRY_KEY","description":"Used to track user\u2019s interaction with embedded content.","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"LogsDatabaseV2:V#||LogsRequestsStore","description":"Used to track user\u2019s interaction with embedded content.","is_regex":false,"provider":"youtube.com","expiration":"Persistent"},{"name":"remote_sid","description":"Necessary for the implementation and functionality of YouTube video-content on the website.  ","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"TESTCOOKIESENABLED","description":"Used to track user\u2019s interaction with embedded content.","is_regex":false,"provider":"youtube.com","expiration":"1 day"},{"name":"VISITOR_INFO1_LIVE","description":"&nbsp;","is_regex":false,"provider":"youtube.com","expiration":"180 days"},{"name":"YSC","description":"&nbsp;","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"YtIdbMeta#databases","description":"Used to track user\u2019s interaction with embedded content.","is_regex":false,"provider":"youtube.com","expiration":"Persistent"},{"name":"yt-remote-cast-available","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"yt-remote-cast-installed","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"yt-remote-connected-devices","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"Persistent"},{"name":"yt-remote-device-id","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"Persistent"},{"name":"yt-remote-fast-check-period","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"yt-remote-session-app","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"yt-remote-session-name","description":"Stores the user's video player preferences using embedded YouTube video","is_regex":false,"provider":"youtube.com","expiration":"session"},{"name":"_gcl_au","description":"Used by Google AdSense for experimenting with advertisement efficiency across websites using their services.","is_regex":false,"provider":"Google","expiration":"3 months"}]},{"title":"Uncategorized cookies","description":"We are still analyzing these cookies and working on their categorization.","toggle":{"value":"unknown","enabled":false,"readonly":false},"cookie_table":[{"name":"popupShown","description":"&nbsp;","is_regex":false,"provider":"enamine.net","expiration":"Persistent"}]},{"title":"","description":"Detailed information about how we handle cookies could be found in our <a aria-label='Privacy policy' class='cc-link' href='\/privacy-policy'>Privacy policy<\/a>."},{"title":"","description":"<div class=\"n3tcc-consent-info\">Consent granted on: <strong>{{consent_date}}<\/strong><br\/>Consent ID: <strong>{{consent_guid}}<\/strong><\/div>"}]}}}},
